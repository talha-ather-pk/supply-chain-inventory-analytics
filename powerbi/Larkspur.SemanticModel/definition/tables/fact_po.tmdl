	partition fact_po = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(DataFolder & "fact_po.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    Kept = Table.SelectColumns(Promoted, {"po_id", "sku", "order_week", "due_date", "received_date", "qty", "days_late", "late"}),
				    Blanks = Table.TransformColumns(Kept, {}, each if _ = "" then null else _),
				    Typed = Table.TransformColumnTypes(Blanks, {{"po_id", type text}, {"sku", type text}, {"order_week", type date}, {"due_date", type date}, {"received_date", type date}, {"qty", Int64.Type}, {"days_late", type number}, {"late", type number}}, "en-US")
				in
				    Typed

	annotation PBI_ResultType = Table
