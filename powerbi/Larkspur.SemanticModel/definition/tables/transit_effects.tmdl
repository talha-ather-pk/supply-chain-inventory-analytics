	partition transit_effects = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(DataFolder & "transit_effects.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    Kept = Table.SelectColumns(Promoted, {"effect", "estimated_days", "true_days", "error_days"}),
				    Blanks = Table.TransformColumns(Kept, {}, each if _ = "" then null else _),
				    Typed = Table.TransformColumnTypes(Blanks, {{"effect", type text}, {"estimated_days", type number}, {"true_days", type number}, {"error_days", type number}}, "en-US")
				in
				    Typed

	annotation PBI_ResultType = Table
