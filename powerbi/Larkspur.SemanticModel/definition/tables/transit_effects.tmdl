table transit_effects
	lineageTag: f1bfc1d4-86bd-58fa-93fb-435b65d268a4

	column effect
		dataType: string
		lineageTag: 045eeef3-f801-509a-a6e0-e632d855777a
		summarizeBy: none
		sourceColumn: effect

		annotation SummarizationSetBy = User

	column estimated_days
		dataType: double
		isHidden
		lineageTag: c6629ca7-225c-546e-b7d2-a481625dcc79
		summarizeBy: none
		sourceColumn: estimated_days

		annotation SummarizationSetBy = User

	column true_days
		dataType: double
		isHidden
		lineageTag: 58e4e882-562f-51a1-b252-962d7f3a5a9f
