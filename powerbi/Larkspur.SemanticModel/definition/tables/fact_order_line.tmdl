	partition fact_order_line = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(DataFolder & "fact_order_line.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    Kept = Table.SelectColumns(Promoted, {"line_key", "order_id", "sku", "customer_id", "order_week", "order_date", "promised_date", "ship_date", "delivery_date", "ship_mode", "carrier", "status", "qty", "unit_price", "revenue", "cogs", "freight_cost", "expedite_premium", "chargeback", "lost_revenue", "lost_margin", "on_time", "days_late", "transit_days", "days_to_ship", "waited_for_stock", "expedited", "is_sample", "pod_missing", "peak_sea", "shipped"}),
				    Blanks = Table.TransformColumns(Kept, {}, each if _ = "" then null else _),
				    Typed = Table.TransformColumnTypes(Blanks, {{"line_key", type text}, {"order_id", type text}, {"sku", type text}, {"customer_id", type text}, {"order_week", type date}, {"order_date", type date}, {"promised_date", type date}, {"ship_date", type date}, {"delivery_date", type date}, {"ship_mode", type text}, {"carrier", type text}, {"status", type text}, {"qty", Int64.Type}, {"unit_price", type number}, {"revenue", type number}, {"cogs", type number}, {"freight_cost", type number}, {"expedite_premium", type number}, {"chargeback", type number}, {"lost_revenue", type number}, {"lost_margin", type number}, {"on_time", type number}, {"days_late", type number}, {"transit_days", type number}, {"days_to_ship", type number}, {"waited_for_stock", Int64.Type}, {"expedited", Int64.Type}, {"is_sample", Int64.Type}, {"pod_missing", Int64.Type}, {"peak_sea", Int64.Type}, {"shipped", Int64.Type}}, "en-US"),
				    Season = Table.AddColumn(Typed, "season", each if [ship_date] = null then null else if Date.Month([ship_date]) >= 10 then "Oct – Dec" else "Jan – Sep", type text),
				    Dispatch = Table.AddColumn(Season, "dispatch", each if [waited_for_stock] = 1 then "Waited for stock" else "From stock", type text)
				in
				    Dispatch

	annotation PBI_ResultType = Table
