table findings
	lineageTag: 15869e16-bce0-556d-a373-a714c95efb79

	column key
		dataType: string
		lineageTag: 920aaf6f-525a-545a-9fb6-b25d8eb24055
		summarizeBy: none
		sourceColumn: key

		annotation SummarizationSetBy = User

	column value
		dataType: double
		isHidden
		lineageTag: f82b41c8-4ca2-5ea0-a67d-ee09072e424c
		summarizeBy: none
		sourceColumn: value

		annotation SummarizationSetBy = User

	column finding
		dataType: string
		lineageTag: 27ec6bbc-0638-53b1-a12a-b4645ef77444
		summarizeBy: none
		sourceColumn: finding

		annotation SummarizationSetBy = User

	partition findings = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(DataFolder & "findings.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    Kept = Table.SelectColumns(Promoted, {"key", "value", "finding"}),
				    Blanks = Table.TransformColumns(Kept, {}, each if _ = "" then null else _),
				    Typed = Table.TransformColumnTypes(Blanks, {{"key", type text}, {"value", type number}, {"finding", type text}}, "en-US")
				in
				    Typed

	annotation PBI_ResultType = Table
