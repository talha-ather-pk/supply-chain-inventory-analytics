	partition leaks = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(DataFolder & "leaks.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    Kept = Table.SelectColumns(Promoted, {"year", "step", "item", "kind", "amount"}),
				    Blanks = Table.TransformColumns(Kept, {}, each if _ = "" then null else _),
				    Typed = Table.TransformColumnTypes(Blanks, {{"year", Int64.Type}, {"step", Int64.Type}, {"item", type text}, {"kind", type text}, {"amount", type number}}, "en-US")
				in
				    Typed

	annotation PBI_ResultType = Table
