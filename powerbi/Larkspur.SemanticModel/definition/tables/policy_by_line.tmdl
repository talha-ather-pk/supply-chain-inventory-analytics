	partition policy_by_line = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(DataFolder & "policy_by_line.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    Kept = Table.SelectColumns(Promoted, {"policy", "production_line", "fill_rate_pct", "weeks_short_pct", "avg_stock_value_usd"}),
				    Blanks = Table.TransformColumns(Kept, {}, each if _ = "" then null else _),
				    Typed = Table.TransformColumnTypes(Blanks, {{"policy", type text}, {"production_line", type text}, {"fill_rate_pct", type number}, {"weeks_short_pct", type number}, {"avg_stock_value_usd", type number}}, "en-US")
				in
				    Typed

	annotation PBI_ResultType = Table
