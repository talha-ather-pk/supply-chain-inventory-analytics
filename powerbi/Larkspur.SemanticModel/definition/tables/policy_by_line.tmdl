		sourceColumn: fill_rate_pct

		annotation SummarizationSetBy = User

	column weeks_short_pct
		dataType: double
		isHidden
		lineageTag: 70ca2853-e304-5f19-ad6b-ec4c0f660442
		summarizeBy: none
