table policy_by_line
	lineageTag: b0d251a4-464e-5d2f-915f-8bedb3663e32

	column policy
		dataType: string
		lineageTag: fe316d34-8ab1-5b27-9b9c-25cd5767a9ab
		summarizeBy: none
		sourceColumn: policy

