	measure 'Leak Year' = IF ( ISFILTERED ( dim_week[year] ) && HASONEVALUE ( dim_week[year] ), VALUES ( dim_week[year] ), 2025 )
		formatString: 0
		isHidden
		displayFolder: 9 Helpers
		lineageTag: 0bd146c8-e924-5bf0-8b11-5b448adf968d

	measure 'Leak Bridge' = VAR y = [Leak Year] RETURN CALCULATE ( SUM ( leaks[amount] ), leaks[year] = y, leaks[kind] IN { "bridge", "cost" } )
		formatString: \$#,0;(\$#,0);\$#,0
		displayFolder: 5 Leaks
		lineageTag: 9cf41e2e-994f-599d-813b-b3cd8074277e

	measure 'Avoidable Leaks' = VAR y = [Leak Year] RETURN - CALCULATE ( SUM ( leaks[amount] ), leaks[year] = y, leaks[item] IN { "Expedite premium", "Late chargebacks", "Returns", "Obsolete stock" } )
		formatString: \$#,0;(\$#,0);\$#,0
		displayFolder: 5 Leaks
		lineageTag: 8c758519-aa59-5ebe-9b9b-93a587b38809

	measure 'Leak Revenue' = VAR y = [Leak Year] RETURN CALCULATE ( SUM ( leaks[amount] ), leaks[year] = y, leaks[item] = "Revenue" )
		formatString: \$#,0;(\$#,0);\$#,0
		displayFolder: 5 Leaks
		lineageTag: ef7beada-5cf7-5b66-9747-fb1d18bb2211

	measure 'Leak Gross Margin' = VAR y = [Leak Year] RETURN CALCULATE ( SUM ( leaks[amount] ), leaks[year] = y, leaks[item] IN { "Revenue", "Cost of goods" } )
		formatString: \$#,0;(\$#,0);\$#,0
		displayFolder: 5 Leaks
		lineageTag: f34af518-4fe1-5617-9aaa-681b063964f9

	measure 'Avoidable Leaks %' = DIVIDE ( [Avoidable Leaks], [Leak Revenue] )
		formatString: 0.00%;-0.00%;0.00%
		displayFolder: 5 Leaks
		lineageTag: 039a0d71-592f-5ac6-ae20-0e186f8e83cf

	measure 'Leak Carrying' = VAR y = [Leak Year] RETURN - CALCULATE ( SUM ( leaks[amount] ), leaks[year] = y, leaks[item] = "Inventory carrying" )
		formatString: \$#,0;(\$#,0);\$#,0
		displayFolder: 5 Leaks
		lineageTag: bbba46a8-52aa-5b34-a98e-37e1fec22282

	measure 'Leak Lost Margin' = VAR y = [Leak Year] RETURN CALCULATE ( SUM ( leaks[amount] ), leaks[year] = y, leaks[kind] = "memo" )
		formatString: \$#,0;(\$#,0);\$#,0
		displayFolder: 5 Leaks
		lineageTag: cdedd54f-8584-55e4-8587-40f771b38186

	measure 'Leak Contribution' = VAR y = [Leak Year] RETURN CALCULATE ( SUM ( leaks[amount] ), leaks[year] = y, leaks[kind] IN { "bridge", "cost" } )
		formatString: \$#,0;(\$#,0);\$#,0
		displayFolder: 5 Leaks
		lineageTag: a9427d10-0749-5a9e-8612-afa6742b32e5

