		displayFolder: 1 Sales
		lineageTag: e04ab2c2-9807-5ece-80cb-874694d844fc

	measure 'Lines Lost %' = DIVIDE ( CALCULATE ( COUNTROWS ( fact_order_line ), KEEPFILTERS ( fact_order_line[status] = "Cancelled - stock-out" ) ), [Order Lines] )
		formatString: 0.00%;-0.00%;0.00%
		displayFolder: 1 Sales
		lineageTag: ad97d4e2-ab19-5777-9a94-9ce591cedaa2

	measure Freight = SUM ( fact_order_line[freight_cost] )
		formatString: \$#,0;(\$#,0);\$#,0
		displayFolder: 1 Sales
		lineageTag: 99c43633-fe47-56ae-9316-dbc737e8d801

	measure 'Returns Cost' = SUMX ( fact_return, fact_return[refund_value] + fact_return[return_freight] )
		formatString: \$#,0;(\$#,0);\$#,0
		displayFolder: 1 Sales
		lineageTag: f1a0ea6a-45a6-53d7-99c9-bede86d45eb9

	measure Contribution = [Gross Margin] - [Freight] - [Chargebacks] - [Returns Cost]
		formatString: \$#,0;(\$#,0);\$#,0
		displayFolder: 1 Sales
		lineageTag: 3b546156-f1bc-51f1-aa38-a6fe0c0a4caa

	measure 'Contribution %' = DIVIDE ( [Contribution], [Revenue] )
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: 1 Sales
		lineageTag: 2632b525-b573-5ec8-b20f-94ed21035c4b

	measure 'Service Leaks' = [Chargebacks] + [Expedite Premium] + [Returns Cost]
		formatString: \$#,0;(\$#,0);\$#,0
		displayFolder: 1 Sales
		lineageTag: 453803ce-54ee-52de-8d29-1c5e148b5669

	measure 'On-time %' = AVERAGE ( fact_order_line[on_time] )
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: 2 Delivery
		lineageTag: bf72d667-077e-54da-8fef-93204059e520

	measure 'Late Lines' = CALCULATE ( COUNTROWS ( fact_order_line ), KEEPFILTERS ( fact_order_line[on_time] = 0 ) )
		formatString: #,0
		displayFolder: 2 Delivery
		lineageTag: 660674af-ae0c-58db-8996-6c58232b3b64

	measure 'OTIF %' = DIVIDE ( CALCULATE ( SUM ( fact_order_line[qty] ), KEEPFILTERS ( fact_order_line[shipped] = 1 ), KEEPFILTERS ( fact_order_line[on_time] = 1 ) ), CALCULATE ( SUM ( fact_order_line[qty] ), KEEPFILTERS ( fact_order_line[status] <> "Open backorder" ) ) )
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: 2 Delivery
		lineageTag: 753be5bd-84c9-541c-8c93-e29e16a32be9

	measure 'Avg Days Late' = CALCULATE ( AVERAGE ( fact_order_line[days_late] ), KEEPFILTERS ( fact_order_line[on_time] = 0 ) )
		formatString: #,0.0
		displayFolder: 2 Delivery
		lineageTag: 25643751-f22b-55c8-8b19-484f927f5e62

	measure 'Avg Transit Days' = AVERAGE ( fact_order_line[transit_days] )
