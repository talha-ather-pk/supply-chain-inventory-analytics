	measure 'DQ Rows' = SUM ( dq_log[rows_affected] )
		formatString: #,0
		displayFolder: 6 Data quality
		lineageTag: c343aba8-5c39-5860-abbe-6ba9b94c3460

	measure 'DQ Injected' = SUM ( dq_log[injected] )
		formatString: #,0
		displayFolder: 6 Data quality
		lineageTag: fd2f75ca-3574-5058-b47d-1c088514d377

	measure 'DQ Match' = IF ( ISBLANK ( [DQ Injected] ), BLANK (), IF ( [DQ Rows] = [DQ Injected], "✓", "✗" ) )
		displayFolder: 6 Data quality
		lineageTag: cfd344f8-1dd1-59d7-adff-02b1cdd56d0b

	measure Fixes = CALCULATE ( [DQ Rows], NOT ISBLANK ( dq_log[injected] ) )
		formatString: #,0
		displayFolder: 6 Data quality
		lineageTag: affc4377-8068-5330-890b-45656cf1b5ac

	measure 'Rows Removed' = CALCULATE ( [Fixes], dq_log[issue] IN { "Exact duplicate lines (re-run export)", "Test lines from ERP go-live", "Credit notes booked as negative lines", "Count keyed in but not finished" } )
		formatString: #,0
		displayFolder: 6 Data quality
		lineageTag: ef922fc3-c287-5048-9063-3af3daeef4d1

	measure 'Field Fixes' = CALCULATE ( [Fixes], NOT dq_log[issue] IN { "Exact duplicate lines (re-run export)", "Test lines from ERP go-live", "Credit notes booked as negative lines", "Count keyed in but not finished" } )
		formatString: #,0
		displayFolder: 6 Data quality
		lineageTag: 02cf26a7-8b41-530a-b60d-5f45f3f365ed

	measure 'Lines Received' = CALCULATE ( [DQ Rows], dq_log[table_name] = "order_lines", dq_log[issue] = "Rows received" )
		formatString: #,0
		displayFolder: 6 Data quality
		lineageTag: fdc785a6-4a57-5e86-8dd4-27332b4c4903

	measure 'Clean Lines' = CALCULATE ( [DQ Rows], dq_log[issue] = "Clean order lines" )
		formatString: #,0
		displayFolder: 6 Data quality
		lineageTag: 37890f63-24ab-58aa-a285-8268ee3488d1

	measure 'Checks Matched' = VAR t = FILTER ( dq_log, NOT ISBLANK ( dq_log[injected] ) ) RETURN COUNTROWS ( FILTER ( t, dq_log[rows_affected] = dq_log[injected] ) ) & " of " & COUNTROWS ( t ) & " fixes = injected count"
