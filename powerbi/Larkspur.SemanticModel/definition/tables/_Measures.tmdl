table _Measures
	lineageTag: 1d346dbe-a89c-5d1d-9abc-f34fc3f85847

	measure Revenue = SUM ( fact_order_line[revenue] )
		formatString: \$#,0;(\$#,0);\$#,0
		displayFolder: 1 Sales
		lineageTag: 00f5e39f-f578-5aec-ab18-90efbd673858

	measure COGS = SUM ( fact_order_line[cogs] )
		formatString: \$#,0;(\$#,0);\$#,0
		displayFolder: 1 Sales
		lineageTag: 3dd434ea-2b2a-5ff1-9df1-4feb6cb67bba

	measure 'Gross Margin' = [Revenue] - [COGS]
		formatString: \$#,0;(\$#,0);\$#,0
		displayFolder: 1 Sales
		lineageTag: 15ea62d4-1c35-5a9a-9fa3-d359fdfc4b64

	measure 'Gross Margin %' = DIVIDE ( [Gross Margin], [Revenue] )
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: 1 Sales
		lineageTag: 118866b4-0915-5c69-9046-34b5f3d4ad30

	measure 'Order Lines' = COUNTROWS ( fact_order_line )
