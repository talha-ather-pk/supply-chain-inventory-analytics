		displayFolder: 1 Sales
		lineageTag: 213b5678-0314-50d8-b4b1-3afbfc56c1e3

	measure 'Shipped Lines' = CALCULATE ( COUNTROWS ( fact_order_line ), KEEPFILTERS ( fact_order_line[shipped] = 1 ) )
		formatString: #,0
		displayFolder: 1 Sales
		lineageTag: adf65e76-7715-5ade-8b48-c77f86eb6f22

	measure 'Units Ordered' = SUM ( fact_order_line[qty] )
