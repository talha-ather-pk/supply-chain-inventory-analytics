		lineageTag: 08bc2f37-76e4-50a5-a6ca-7e13eed746c6

	measure 'Waited Share' = CALCULATE ( AVERAGE ( fact_order_line[waited_for_stock] ), KEEPFILTERS ( fact_order_line[shipped] = 1 ) )
