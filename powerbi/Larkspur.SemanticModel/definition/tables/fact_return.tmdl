	partition fact_return = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(DataFolder & "fact_return.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    Kept = Table.SelectColumns(Promoted, {"return_id", "order_id", "sku", "return_week", "return_date", "reason", "return_qty", "refund_value", "return_freight"}),
				    Blanks = Table.TransformColumns(Kept, {}, each if _ = "" then null else _),
				    Typed = Table.TransformColumnTypes(Blanks, {{"return_id", type text}, {"order_id", type text}, {"sku", type text}, {"return_week", type date}, {"return_date", type date}, {"reason", type text}, {"return_qty", Int64.Type}, {"refund_value", type number}, {"return_freight", type number}}, "en-US"),
				    Ord_reason_order = Table.AddColumn(Typed, "reason_order", each if [reason] = null then null else List.PositionOf({"Defect - shade / stitching", "Damaged in transit", "Wrong item shipped"}, [reason]) + 1, Int64.Type)
				in
				    Ord_reason_order

	annotation PBI_ResultType = Table
