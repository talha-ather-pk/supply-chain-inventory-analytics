table dim_customer
	lineageTag: d462617b-8760-50e2-b779-7fea7a79142c

	column customer_id
		dataType: string
		isKey
		lineageTag: 095620ce-20d0-5a07-b38a-8ea4641a7bf9
		summarizeBy: none
