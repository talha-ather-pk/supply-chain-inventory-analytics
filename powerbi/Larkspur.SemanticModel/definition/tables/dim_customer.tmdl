	column customer_name
		dataType: string
		lineageTag: d3d20d7b-5a38-5a21-87ac-c6492e727c05
		summarizeBy: none
		sourceColumn: customer_name

		annotation SummarizationSetBy = User

	column market
		dataType: string
		lineageTag: 9337f5ca-40a5-5470-a433-d7c5eb7c47b4
		summarizeBy: none
		sourceColumn: market

		annotation SummarizationSetBy = User

	column channel
		dataType: string
		lineageTag: 8048455b-9d51-5c06-8bc8-0f22d3fd4984
		summarizeBy: none
		sourceColumn: channel

