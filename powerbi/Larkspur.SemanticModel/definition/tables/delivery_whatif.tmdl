table delivery_whatif
	lineageTag: 7bba6db7-6aa0-50d7-95af-a31026b5214c

	column order
		dataType: int64
		isHidden
		formatString: 0
		lineageTag: 71c29ab1-6531-5ba7-b750-ac71dbeb38e2
		summarizeBy: none
		sourceColumn: order

		annotation SummarizationSetBy = User

	column scenario
		dataType: string
		sortByColumn: order
		lineageTag: 22a840fa-e648-5786-add3-333104144a1f
		summarizeBy: none
		sourceColumn: scenario

		annotation SummarizationSetBy = User

	column on_time
		dataType: double
