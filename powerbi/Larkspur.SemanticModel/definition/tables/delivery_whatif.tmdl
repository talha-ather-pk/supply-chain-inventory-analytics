	partition delivery_whatif = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(DataFolder & "delivery_whatif.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    Kept = Table.SelectColumns(Promoted, {"order", "scenario", "on_time", "gain_pts"}),
				    Blanks = Table.TransformColumns(Kept, {}, each if _ = "" then null else _),
				    Typed = Table.TransformColumnTypes(Blanks, {{"order", Int64.Type}, {"scenario", type text}, {"on_time", type number}, {"gain_pts", type number}}, "en-US")
				in
				    Typed

	annotation PBI_ResultType = Table
