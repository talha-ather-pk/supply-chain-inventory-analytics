table policy_weekly
	lineageTag: 67751b17-bdb1-5790-a150-be35e39e1b6e

	column week_start
		dataType: dateTime
		formatString: mmm yyyy
		lineageTag: 2e516840-e32c-5a5d-8301-b251e3e961ae
		summarizeBy: none
		sourceColumn: week_start

		annotation SummarizationSetBy = User

	column policy
		dataType: string
		lineageTag: 634fd0f1-cc45-536e-996a-5db42cf725f1
		summarizeBy: none
		sourceColumn: policy

		annotation SummarizationSetBy = User

	column stock_value
		dataType: double
		isHidden
		lineageTag: 34f14b0f-ab05-52ba-8960-997c3a999254
		summarizeBy: none
		sourceColumn: stock_value

		annotation SummarizationSetBy = User

	column lost_units
		dataType: double
		isHidden
		lineageTag: b3d00862-f0a6-5cf7-8567-51657ee53d70
		summarizeBy: none
		sourceColumn: lost_units

		annotation SummarizationSetBy = User

	partition policy_weekly = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(DataFolder & "policy_weekly.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    Kept = Table.SelectColumns(Promoted, {"week_start", "policy", "stock_value", "lost_units"}),
				    Blanks = Table.TransformColumns(Kept, {}, each if _ = "" then null else _),
				    Typed = Table.TransformColumnTypes(Blanks, {{"week_start", type date}, {"policy", type text}, {"stock_value", type number}, {"lost_units", type number}}, "en-US")
				in
				    Typed

	annotation PBI_ResultType = Table
