	partition dim_sku = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(DataFolder & "dim_sku.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    Kept = Table.SelectColumns(Promoted, {"sku", "sku_label", "product_name", "category", "fabric", "size", "colour", "production_line", "lead_time_wk", "zone", "status", "list_price", "unit_cost", "abc", "xyz", "class", "mean_weekly_demand", "cv", "service_level", "safety_stock", "rop_current", "rop_recommended", "rop_change_pct", "order_qty_current", "reorder_status", "in_policy"}),
				    Blanks = Table.TransformColumns(Kept, {}, each if _ = "" then null else _),
				    Typed = Table.TransformColumnTypes(Blanks, {{"sku", type text}, {"sku_label", type text}, {"product_name", type text}, {"category", type text}, {"fabric", type text}, {"size", type text}, {"colour", type text}, {"production_line", type text}, {"lead_time_wk", Int64.Type}, {"zone", type text}, {"status", type text}, {"list_price", type number}, {"unit_cost", type number}, {"abc", type text}, {"xyz", type text}, {"class", type text}, {"mean_weekly_demand", type number}, {"cv", type number}, {"service_level", type number}, {"safety_stock", type number}, {"rop_current", type number}, {"rop_recommended", type number}, {"rop_change_pct", type number}, {"order_qty_current", type number}, {"reorder_status", type text}, {"in_policy", Int64.Type}}, "en-US"),
				    Ord_reorder_order = Table.AddColumn(Typed, "reorder_order", each if [reorder_status] = null then null else List.PositionOf({"Reorder now", "Watch", "OK", "Discontinued", "New / not planned"}, [reorder_status]) + 1, Int64.Type)
				in
				    Ord_reorder_order

	annotation PBI_ResultType = Table
