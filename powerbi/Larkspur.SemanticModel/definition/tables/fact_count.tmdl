table fact_count
	lineageTag: 4ba4cc27-3d96-5444-991e-7872ac31e183

	column count_week
		dataType: dateTime
		isHidden
		formatString: dd mmm yyyy
		lineageTag: 10c9b3f7-9580-555f-9708-904024249aa4
		summarizeBy: none
		sourceColumn: count_week

		annotation SummarizationSetBy = User

	column count_date
		dataType: dateTime
		isHidden
		formatString: dd mmm yyyy
		lineageTag: 98b4e3df-f923-53cc-bd25-408b1eaaaa9a
		summarizeBy: none
		sourceColumn: count_date

		annotation SummarizationSetBy = User

	column sku
		dataType: string
		isHidden
		lineageTag: f2ca290f-dd90-5623-a7d8-6a5e6cdf3a74
		summarizeBy: none
		sourceColumn: sku

		annotation SummarizationSetBy = User

	column zone
		dataType: string
		lineageTag: 45be640d-471b-506c-99b4-d3cef373a73c
		summarizeBy: none
		sourceColumn: zone

		annotation SummarizationSetBy = User

	column system_qty
		dataType: int64
		isHidden
		formatString: 0
		lineageTag: 1a5782be-21ce-5a35-bb7e-f011120a762f
		summarizeBy: none
		sourceColumn: system_qty

		annotation SummarizationSetBy = User

	column counted_qty
		dataType: double
		isHidden
		lineageTag: b0ad22b0-3443-50a1-b22c-7433b4c2457b
		summarizeBy: none
		sourceColumn: counted_qty

		annotation SummarizationSetBy = User

	column variance_units
		dataType: double
		isHidden
		lineageTag: 13dab398-fc73-524d-aa54-59f18a28b738
		summarizeBy: none
		sourceColumn: variance_units

		annotation SummarizationSetBy = User

	column accurate
		dataType: int64
		isHidden
		formatString: 0
		lineageTag: 8960486a-fbca-5c3f-bac8-54daf54a46f4
		summarizeBy: none
		sourceColumn: accurate

		annotation SummarizationSetBy = User

	partition fact_count = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(DataFolder & "fact_count.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    Kept = Table.SelectColumns(Promoted, {"count_week", "count_date", "sku", "zone", "system_qty", "counted_qty", "variance_units", "accurate"}),
				    Blanks = Table.TransformColumns(Kept, {}, each if _ = "" then null else _),
				    Typed = Table.TransformColumnTypes(Blanks, {{"count_week", type date}, {"count_date", type date}, {"sku", type text}, {"zone", type text}, {"system_qty", Int64.Type}, {"counted_qty", type number}, {"variance_units", type number}, {"accurate", Int64.Type}}, "en-US")
				in
				    Typed

	annotation PBI_ResultType = Table
